{
  "name": "healscrape-sqlite",
  "version": "0.1.0",
  "description": "SQLite storage backend for healscrape",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "^11"
  },
  "peerDependencies": {
    "healscrape": "^0.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7",
    "@types/node": "^22",
    "healscrape": "file:../../",
    "tsup": "^8",
    "typescript": "^5",
    "vitest": "^3"
  }
}
